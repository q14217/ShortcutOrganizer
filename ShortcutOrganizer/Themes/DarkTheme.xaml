<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush"        Color="#FF4A8AF4"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#FF6BA0F7"/>
    <SolidColorBrush x:Key="AccentLightBrush"   Color="#FF243044"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FF2B2F36"/>
    <SolidColorBrush x:Key="PageBrush"          Color="#FF1C1F24"/>
    <SolidColorBrush x:Key="LineBrush"          Color="#FF3A3F48"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#FF343942"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFEAEDF2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA3B2"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFFF6B6F"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#FF4FCB88"/>
    <SolidColorBrush x:Key="EmptyStateBrush"    Color="#FF6A7280"/>

    <Color x:Key="AccentColor">#FF4A8AF4</Color>
    <Color x:Key="ShadowColor">#55000000</Color>
</ResourceDictionary>