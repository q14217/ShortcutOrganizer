<Window x:Class="ShortcutOrganizer.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加到分类"
        Height="420" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要添加到的分类"
                   FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" x:Name="FileNameText"
                   Text="" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,10"/>

        <ListBox x:Name="CategoryListBox" Grid.Row="2"
                 SelectionMode="Single"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource LineBrush}"
                 BorderThickness="1"
                 Padding="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="6,4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Click="Ok_Click"
                    Padding="20,6" Margin="0,0,10,0"
                    IsDefault="True"/>
            <Button Content="取消" Click="Cancel_Click"
                    Padding="20,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>