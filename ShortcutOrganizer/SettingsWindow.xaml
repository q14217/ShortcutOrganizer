<Window x:Class="ShortcutOrganizer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙ 设置"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="全局热键" FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource AccentBrush}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="修饰键" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="ModCtrlCheck"  Content="Ctrl"  Margin="0,0,12,0"/>
                        <CheckBox x:Name="ModAltCheck"   Content="Alt"   Margin="0,0,12,0"/>
                        <CheckBox x:Name="ModShiftCheck" Content="Shift" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ModWinCheck"   Content="Win"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="按键" VerticalAlignment="Center"/>
                    <TextBox x:Name="HotKeyTextBox" Grid.Column="1"
                             Padding="8,4"
                             Width="100" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock x:Name="HotKeyStatusText"
                           Margin="120,4,0,0" FontSize="11" TextWrapping="Wrap" Text=""/>

                <TextBlock Text="提示：修改后点击“保存”立即生效。若被其它程序占用会提示更换。"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" Margin="0,8,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="视图" FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource AccentBrush}"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="显示方式" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ViewModeCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left">
                        <ComboBoxItem Content="卡片视图" Tag="Card"/>
                        <ComboBoxItem Content="列表视图" Tag="List"/>
                    </ComboBox>
                </Grid>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="启动与托盘" FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource AccentBrush}"/>
                <CheckBox x:Name="AutoBackupCheck" Content="每天首次启动自动备份数据"
                          Margin="0,4,0,4"/>
                <CheckBox x:Name="MinTrayCheck" Content="最小化时隐藏到系统托盘"
                          Margin="0,4,0,4"/>
                <CheckBox x:Name="ShowBalloonCheck" Content="隐藏到托盘时显示气泡提示"
                          Margin="0,4,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="资源管理器集成" FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource AccentBrush}"/>
                <CheckBox x:Name="ContextMenuCheck"
                          Content="在文件右键菜单中添加“发送到奥格快捷收纳箱”"
                          Margin="0,4,0,4"/>
                <TextBlock Text="开启后，右键任意文件即可快速添加到某个分类。"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="数据目录" FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="打开数据目录" Click="OpenDataDir_Click" Padding="12,4"/>
                    <Button Content="打开日志目录" Click="OpenLogDir_Click" Padding="12,4" Margin="10,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="保存" Click="Save_Click" Padding="20,6" Margin="0,0,10,0"/>
            <Button Content="取消" Click="Cancel_Click" Padding="20,6"/>
        </StackPanel>
    </Grid>
</Window>