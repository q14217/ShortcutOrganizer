<Window x:Class="ShortcutOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:local="clr-namespace:ShortcutOrganizer"
        Title="奥格快捷收纳箱"
        Height="680" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="app.ico"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        FontSize="12"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="16" ShadowDepth="2"
                          Direction="270" Opacity="0.10" Color="{DynamicResource ShadowColor}"/>
        <DropShadowEffect x:Key="CardHoverShadow" BlurRadius="14" ShadowDepth="3"
                          Direction="270" Opacity="0.22" Color="{DynamicResource AccentColor}"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
        </Style>

        <Style x:Key="IconToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="SortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CategoryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 卡片模板 -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Width="132" Height="152" Margin="6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Click="OpenShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="以管理员运行" Click="RunAsAdminMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="打开文件位置" Click="OpenFileLocationMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem x:Name="PinMenuItem" Header="固定到常用" Click="TogglePinMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="重命名" Click="RenameShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="移动到分类" Click="MoveShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="复制目标路径" Click="CopyPathMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="卸载" Click="UninstallShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除" Click="DeleteShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="属性" Click="PropertiesShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="46" Height="46"/>
                        <Ellipse x:Name="InvalidDot" Width="9" Height="9"
                                 Fill="{DynamicResource DangerBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-4,-4,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="PinMark" Text="📌" FontSize="11"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="-4,-4,0,0"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="11.5" LineHeight="15"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               MaxHeight="48" VerticalAlignment="Top"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CreatedTime, StringFormat={}{0:yyyy-MM-dd}}"
                                   FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="  ·  打开 " FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding OpenCount}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter TargetName="InvalidDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 列表模板 -->
        <DataTemplate x:Key="ListTemplate">
            <Border x:Name="ListCard"
                    Padding="8,6" Margin="2,1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Click="OpenShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="以管理员运行" Click="RunAsAdminMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="打开文件位置" Click="OpenFileLocationMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="固定到常用" Click="TogglePinMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="重命名" Click="RenameShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="移动到分类" Click="MoveShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="复制目标路径" Click="CopyPathMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="卸载" Click="UninstallShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除" Click="DeleteShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="属性" Click="PropertiesShortcutMenuItem_Click"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <Ellipse x:Name="InvalidDot" Width="8" Height="8"
                                 Fill="{DynamicResource DangerBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-2,-2,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="PinMark" Text="📌" FontSize="9"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="-2,-2,0,0" Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               VerticalAlignment="Center" Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Grid.Column="2" Text="{Binding Category}"
                               VerticalAlignment="Center" Margin="8,0"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="3" Text="{Binding TargetPath}"
                               VerticalAlignment="Center" Margin="8,0"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               ToolTip="{Binding TargetPath}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="4" Text="{Binding OpenCount, StringFormat=打开 {0}}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,8,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="ListCard" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="ListCard" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter TargetName="InvalidDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ListCard" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="CardPanel">
            <vw:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Margin="12,12,12,0" Padding="6"
                CornerRadius="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                Effect="{StaticResource PanelShadow}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <Button x:Name="AddCategoryButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="AddCategoryButton_Click" ToolTip="新建分类 (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="新建分类" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <Button x:Name="AddShortcutButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="AddShortcutButton_Click" ToolTip="添加快捷方式">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加快捷方式" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AddFileButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="AddFileButton_Click" ToolTip="添加文件">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AddFolderButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="AddFolderButton_Click" ToolTip="批量导入文件夹中的所有快捷方式">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="导入文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <Button x:Name="BatchDeleteButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="BatchDeleteShortcutsButton_Click" ToolTip="批量删除 (Delete)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="批量删除" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BatchMoveButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="BatchMoveShortcutsButton_Click" ToolTip="批量移动">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="批量移动" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="UninstallButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="UninstallButton_Click" ToolTip="卸载选中项">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="卸载" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ScanInvalidButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="ScanInvalidButton_Click" ToolTip="扫描失效项 (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="失效扫描" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <Button x:Name="BackupButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="BackupButton_Click" ToolTip="备份配置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="备份" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="RestoreButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="RestoreButton_Click" ToolTip="从备份恢复">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="恢复" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ExportCsvButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="ExportCsvButton_Click" ToolTip="导出为 CSV 清单">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="导出" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ImportCsvButton" Style="{StaticResource ToolbarButtonStyle}"
                        Click="ImportCsvButton_Click" ToolTip="从 CSV 清单导入">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="导入" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged" ToolTip="按名称搜索 (Ctrl+F)"/>

                <ComboBox x:Name="SortComboBox" Style="{StaticResource SortComboBoxStyle}"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="默认排序" Tag="Default" IsSelected="True"/>
                    <ComboBoxItem Content="名称 A→Z" Tag="NameAsc"/>
                    <ComboBoxItem Content="名称 Z→A" Tag="NameDesc"/>
                    <ComboBoxItem Content="时间 新→旧" Tag="TimeDesc"/>
                    <ComboBoxItem Content="时间 旧→新" Tag="TimeAsc"/>
                    <ComboBoxItem Content="使用频率 高→低" Tag="CountDesc"/>
                </ComboBox>

                <Button x:Name="ViewToggleButton" Style="{StaticResource IconToggleButtonStyle}"
                        Click="ViewToggleButton_Click" ToolTip="切换卡片/列表视图 (Ctrl+L)"
                        Content="🔲"/>

                <Button x:Name="ThemeToggleButton" Style="{StaticResource IconToggleButtonStyle}"
                        Click="ThemeToggleButton_Click" Content="🌙" ToolTip="切换深色/浅色主题"/>

                <Button x:Name="SettingsButton" Style="{StaticResource IconToggleButtonStyle}"
                        Click="SettingsButton_Click" Content="⚙" ToolTip="设置"/>

                <CheckBox x:Name="ShowAllCheckBox"
                          Content="显示所有分类" IsChecked="True"
                          Checked="ShowAllCheckBox_Changed" Unchecked="ShowAllCheckBox_Changed"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          VerticalAlignment="Center" Margin="8,0,4,0" Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分类列表 -->
            <Border Grid.Column="0" Margin="0,0,10,0"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource PanelShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="分类列表" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="（可拖动排序 / 拖入快捷方式）" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="CategoryListBox" Grid.Row="1" Margin="4,6,4,6"
                             SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="CategoryListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CategoryListBox_PreviewMouseMove"
                             DragOver="CategoryListBox_DragOver"
                             DragLeave="CategoryListBox_DragLeave"
                             Drop="CategoryListBox_Drop"
                             SelectionChanged="CategoryListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="CatText" Text="{Binding DisplayName}"
                                           FontSize="12.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CatText" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建分类" Click="AddCategoryContextMenu_Click"/>
                                <Separator/>
                                <MenuItem Header="重命名" Click="RenameCategoryMenuItem_Click"/>
                                <MenuItem Header="删除" Click="DeleteCategoryMenuItem_Click"/>
                                <MenuItem Header="批量删除" Click="BatchDeleteCategoriesMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="全选本分类" Click="SelectAllInCategoryMenuItem_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：快捷方式列表 -->
            <Border Grid.Column="1" CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource PanelShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="CurrentCategoryText"
                                       Text="请选择分类" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}"
                                    CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="共 " Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                    <TextBlock x:Name="ShortcutCountText" Text="0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text=" 个项" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ShortcutListBox" Margin="8"
                                 SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource ShortcutItemContainerStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.CacheLength="2"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 ItemTemplate="{StaticResource CardTemplate}"
                                 ItemsPanel="{StaticResource CardPanel}"
                                 PreviewMouseLeftButtonDown="ShortcutListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ShortcutListBox_PreviewMouseMove"
                                 MouseDoubleClick="ShortcutListBox_MouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开" Click="OpenShortcutMenuItem_Click"/>
                                    <MenuItem Header="打开文件位置" Click="OpenFileLocationMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="批量删除" Click="BatchDeleteShortcutsMenuItem_Click"/>
                                    <MenuItem Header="批量移动分类" Click="BatchMoveShortcutsMenuItem_Click"/>
                                    <MenuItem Header="批量卸载" Click="BatchUninstallShortcutsMenuItem_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Visibility="Collapsed"
                                    IsHitTestVisible="False">
                            <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource EmptyStateBrush}"/>
                            <TextBlock Text="这里还没有快捷方式" FontSize="14" Margin="0,12,0,4"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="拖放文件到窗口，或双击空白处添加" FontSize="11.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource HoverBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="拖放文件到此处添加  |  拖卡片到左侧分类可移动  |  F1 查看快捷键"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Margin="12,0,12,12" Padding="12,4"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="就绪"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionInfoText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button x:Name="UndoButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="UndoButton_Click"
                            ToolTip="撤销上一步操作 (Ctrl+Z)"
                            Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↩" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="撤销" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>